{
  "name": "@capgo/capacitor-transitions",
  "version": "8.1.2",
  "description": "Framework-agnostic page transitions for Capacitor apps - iOS-style navigation without opinions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.mjs",
      "require": "./dist/angular/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.mjs",
      "require": "./dist/solid/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:examples": "bun scripts/dev-frameworks.ts",
    "dev:examples:all": "bun scripts/dev-frameworks.ts --all",
    "dev:examples:all:install": "bun scripts/dev-frameworks.ts --all --install",
    "build:app": "vite --config examples/react-app/vite.config.ts build",
    "build:mobile": "bun run build:app && bunx cap copy",
    "sync": "bunx cap sync",
    "sync:ios": "bunx cap sync ios",
    "sync:android": "bunx cap sync android",
    "ios": "bunx cap run ios",
    "android": "bunx cap run android",
    "deploy:capgo": "bun run build:mobile && bunx @capgo/cli@7.102.0 bundle upload app.capgo.capacitor.transitions --channel production --delta",
    "deploy:capgo:dev": "bun run build:mobile && bunx @capgo/cli@7.102.0 bundle upload app.capgo.capacitor.transitions --channel dev --delta",
    "typecheck": "tsc --noEmit",
    "verify": "bun run verify:web && bun run verify:ios && bun run verify:android",
    "verify:web": "bun run build",
    "verify:mobile": "bun run build:mobile",
    "verify:ios": "bun run build:mobile && xcodebuild -project ios/App/App.xcodeproj -scheme App -destination generic/platform=iOS CODE_SIGNING_ALLOWED=NO",
    "verify:android": "bun run build:mobile && cd android && ./gradlew build test",
    "lint": "bun run eslint && bun run prettier -- --check",
    "fmt": "bun run eslint -- --fix && bun run prettier -- --write",
    "eslint": "eslint .",
    "prettier": "prettier-pretty-check \"**/*.{css,html,ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "capacitor",
    "transitions",
    "router",
    "animations",
    "ios",
    "navigation",
    "page-transitions",
    "web-components",
    "framework-agnostic"
  ],
  "author": "Martin Donadieu <martin@capgo.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/capacitor-transitions.git"
  },
  "bugs": {
    "url": "https://github.com/Cap-go/capacitor-transitions/issues"
  },
  "homepage": "https://capgo.app/docs/plugins/transitions/",
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-updater": "^8.46.1",
    "@capgo/cli": "7.102.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-pretty-check": "^0.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.0.0",
    "@angular/core": ">=17.0.0",
    "svelte": ">=4.0.0",
    "solid-js": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "prettier": "@ionic/prettier-config"
}
