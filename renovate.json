{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "schedule:earlyMondays"],
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackageNames": ["eslint"],
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "matchManagers": ["swift"],
      "matchPackagePatterns": [
        "^https://github.com/ionic-team/capacitor-swift-pm\\.git$",
        "^ionic-team/capacitor-swift-pm$",
        "^capacitor-swift-pm$"
      ],
      "allowedVersions": "8.0.0",
      "enabled": false
    },
    {
      "description": "Cap-go plugins follow the official Capacitor Android toolchain (Gradle wrapper, Android Gradle plugin, Kotlin). Renovate must never bump it.",
      "matchManagers": ["gradle-wrapper"],
      "enabled": false
    },
    {
      "description": "Cap-go plugins follow the official Capacitor Android toolchain (Gradle wrapper, Android Gradle plugin, Kotlin). Renovate must never bump it.",
      "matchPackageNames": [
        "/^com\\.android\\.tools\\.build:gradle$/",
        "/^com\\.android\\.(library|application)/",
        "/^org\\.jetbrains\\.kotlin[:.]/"
      ],
      "enabled": false
    }
  ]
}
